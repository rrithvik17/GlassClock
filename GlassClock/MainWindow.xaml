<Window x:Class="GlassClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="130"
        Height="144"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Disable Clock" Click="DisableClock_Click"/>
            <MenuItem Header="Enable Clock" Click="EnableClock_Click"/>
            <Separator/>
            <MenuItem Header="Start with Windows" IsCheckable="True" Click="Startup_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <StackPanel x:Name="WidgetRoot" Width="130" Height="144" HorizontalAlignment="Center">
    <Grid x:Name="ClockRoot" Width="104" Height="104" HorizontalAlignment="Center" MouseLeftButtonDown="ClockRoot_MouseLeftButtonDown">
        <Ellipse Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.32,0.28" GradientOrigin="0.28,0.24" RadiusX="0.82" RadiusY="0.82">
                    <GradientStop Color="#D9222429" Offset="0"/>
                    <GradientStop Color="#B513151A" Offset="0.58"/>
                    <GradientStop Color="#90101115" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D8FFFFFF" Offset="0"/>
                    <GradientStop Color="#38FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#15FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.StrokeThickness>1.2</Ellipse.StrokeThickness>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.48"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#20FFFFFF" StrokeThickness="0.7"/>

        <Canvas x:Name="ClockCanvas" Width="104" Height="104"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Ellipse Width="5" Height="5" Fill="#E8D7A5"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <Border x:Name="BatteryPanel" Width="124" Height="30" Margin="0,5,0,0"
            HorizontalAlignment="Center" CornerRadius="9"
            BorderThickness="1" BorderBrush="#35FFFFFF"
            Background="#8D15171C" Padding="7,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="BatteryGlyph" Text="▰" FontSize="9" Foreground="#E8D7A5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="BatteryStatusText" Text="BATTERY" FontSize="8" Foreground="#BFC2C8" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="BatteryPercentText" Grid.Row="0" Grid.Column="1" Text="--%"
                       FontSize="10" FontWeight="SemiBold" Foreground="#F2F4F5"
                       VerticalAlignment="Center" Margin="5,0,0,0"/>
            <Border x:Name="BatteryTrack" Grid.Row="1" Grid.ColumnSpan="2" Height="3"
                    CornerRadius="2" Background="#35FFFFFF" Margin="0,4,0,0" ClipToBounds="True">
                <Border x:Name="BatteryFill" Width="0" HorizontalAlignment="Left"
                        CornerRadius="2" Background="#E8D7A5"/>
            </Border>
        </Grid>
    </Border>
    </StackPanel>
</Window>
